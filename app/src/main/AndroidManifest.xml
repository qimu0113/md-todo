<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MD Todo：predictive back 开关的最终取舍（2026-10-18）。

      三轮实验结论：
      1. 开启 android:enableOnBackInvokedCallback="true" 时，
         ColorOS 会在**系统层**做窗口动画（整个窗口右移、露出下层）。
         App 内的 NavHost 过渡拿不到手势进度（ContentTransition 不被 seek），
         结果是「窗口在动、页面内容不动」——和用户想要的「内容滑动」不符。
      2. 关闭该声明时，拖动仅显示系统返回箭头提示，
         松手后由 App 播放自己的 NavHost 过渡，
         可以得到 MusicFree 式的「整屏平移 + 1/3 视差」效果。
      3. MusicFree 本身（React Navigation）也是触发式动画，不跟手——
         用户所说的「像 MusicFree 那样」指向的是视觉质感，不是手势实时跟随。

      故：**关闭声明**。过渡动画完全由 NavHost 控制，视觉可预期、无 ROM 干扰。
      若将来要真正的逐帧跟手，唯一路径是用 OnBackAnimationCallback 完全接管
      （自绘 offset），届时应做好 ANR 验证。
    -->

    <application
        android:name=".TodosianApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Todosian">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Todosian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
<receiver
            android:name=".ui.widget.TodosianWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todosian_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.AddTaskWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_add_task_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todosian_add_task_widget_info" />
        </receiver>
    </application>

</manifest>
